# Public site origin, used for metadata and same-origin form validation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
    
# Google Sheets storage through Apps Script (server-only). See integrations/google-sheets/SETUP.md.
# Set both to store submissions in Sheets instead of sending email.
GOOGLE_SHEETS_WEBHOOK_URL=siof
GOOGLE_SHEETS_WEBHOOK_SECRET=nsdfjk

# Server-only contact email delivery through Resend. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional separate inbox for career applications. Falls back to CONTACT_TO_EMAIL.
CAREERS_TO_EMAIL=

# Optional separate inbox for developer hiring, when using email delivery.
HIRING_TO_EMAIL=
